{
  "name": "terasology-web-presence",
  "description": "Web Presence of Terasology - a Voxel Engine and Game",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "author": "The Terasology Foundation",
  "license": "MIT",
  "keywords": [
    "astro"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "clean": "rm -rf dist .astro node_modules/.astro",
    "astro": "astro",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "lint:md": "remark blog/ docs/ --quiet"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.5",
    "@astrojs/sitemap": "^3.7.4",
    "@popperjs/core": "^2.11.8",
    "astro": "^7.4.8",
    "bootstrap": "^5.3.8",
    "js-search": "^2.0.1",
    "lodash.kebabcase": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-select": "^5.10.2",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "remark-cli": "^12.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "sass": "^1.108.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "remarkConfig": {
    "plugins": [
      "remark-preset-lint-recommended"
    ]
  }
}
