---
import "bootstrap/dist/css/bootstrap.min.css";
import "../styles/style.scss";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";

interface Props {
  /** Heading shown above the page content. */
  heading: string;
  /** Document title prefix; "<title> | Terasology". Omit for the plain site title. */
  title?: string;
  description?: string;
  /** Social preview image, as a site path or absolute URL; defaults to the logo. */
  image?: string;
  /** Open Graph type; "article" for blog posts. */
  type?: "website" | "article";
}

const { heading, title, description = site.description, type = "website" } = Astro.props;
const fullTitle = title ? `${title} | ${site.title}` : site.title;
const url = new URL(Astro.url.pathname, site.url).href;
const image = new URL(Astro.props.image ?? site.logo, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="icon" href="/logos/logo.png" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;700&display=swap"
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={site.twitterUsername} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <Header />
    <div class="container main">
      <div class="mb-4">
        <h1 class="text-center">{heading}</h1>
        <div class="title-underline"></div>
      </div>
      <slot />
    </div>
    <Footer />
    <script>
      import "bootstrap/js/dist/collapse";
      import "bootstrap/js/dist/dropdown";
    </script>
  </body>
</html>
